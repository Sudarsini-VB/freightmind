# FreightMind Environment Configuration
# Copy this file to .env and fill in your values

# Backend
SECRET_KEY=change-this-to-a-random-256-bit-string-in-production
PORT=8000
DEBUG=false

# Frontend
REACT_APP_API=http://localhost:8000

# Optional: Real AI/Quantum backends (leave blank to use built-in simulators)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
IBM_QUANTUM_TOKEN=
DWAVE_API_TOKEN=

# Optional: Real data feeds
AIS_STREAM_API_KEY=
GDELT_API_KEY=

# Database (optional - uses in-memory by default)
DATABASE_URL=

# AWS (for deployment)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
